        end
        subgraph THEMES["Cross-cutting research and applications"]
            THEMEVALUES["Open agricultural technology<br/>Agricultural AI and knowledge systems<br/>Agricultural robotics<br/>Information infrastructure<br/>Ecologically informed agricultural design"]
        end
    end
