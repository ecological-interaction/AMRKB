            F6["Agroecological and<br/>diversified"]
            F7["Precision and<br/>computational"]
            F8["Experimental and<br/>emerging"]
        end
        subgraph TYPES["Distinct record concepts — not a hierarchy"]
            TYPEVALUES["Modes · Systems · Methods · Practices<br/>Technologies · Ecological mechanisms · Indicators"]
        end
        subgraph FUNCTIONS["Cross-family functions"]
